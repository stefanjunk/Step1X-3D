# Host paths and port
STEP1X_HF_CACHE=./.cache/huggingface
STEP1X_PORT=7861
USER_ID=1000
GROUP_ID=1000

# Two-GPU layout for two cards with 16 GB VRAM each
GEOMETRY_DEVICE=cuda:0
TEXTURE_DEVICE=cuda:1
TEXTURE_AUX_DEVICE=cuda:0
TEXTURE_CPU_OFFLOAD=0
BACKGROUND_REMOVAL_DEVICE=cuda:1
BIREFNET_REVISION=e2bf8e4460fc8fa32bba5ea4d94b3233d367b0e4
REMBG_PROVIDER=CPUExecutionProvider

# Exact architecture of both RTX 4060 Ti cards (Ada Lovelace).
TORCH_CUDA_ARCH_LIST=8.9
