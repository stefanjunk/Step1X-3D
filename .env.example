# Host paths and port
STEP1X_HF_CACHE=./.cache/huggingface
STEP1X_PORT=7861
USER_ID=1000
GROUP_ID=1000

# Geometry runs on one card; the second card stays free for other work.
GEOMETRY_DEVICE=cuda:0
REMBG_PROVIDER=CPUExecutionProvider

# Exact architecture of both RTX 4060 Ti cards (Ada Lovelace).
TORCH_CUDA_ARCH_LIST=8.9
